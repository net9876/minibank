{
  "openapi": "3.0.3",
  "info": {
    "title": "MiniBank Payments",
    "version": "1.0.0"
  },
  "paths": {
    "/payments/{paymentId}": {
      "get": {
        "operationId": "GetPayment",
        "summary": "Get payment by ID",
        "parameters": [
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-correlation-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payment identifier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Payment not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentNotFound"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/payments/{paymentId}/guidance": {
      "get": {
        "operationId": "ExplainHold",
        "summary": "Explain hold",
        "parameters": [
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-correlation-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Guidance"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payment identifier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Payment not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentNotFound"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PaymentEvent": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string"
          },
          "sequenceNo": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "reasonCode": {
            "type": "string",
            "nullable": true
          },
          "eventUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Payment": {
        "type": "object",
        "properties": {
          "found": {
            "type": "boolean"
          },
          "paymentId": {
            "type": "string"
          },
          "accountId": {
            "type": "string"
          },
          "beneficiaryId": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "createdUtc": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "reasonCode": {
            "type": "string",
            "nullable": true
          },
          "holdReason": {
            "type": "string",
            "nullable": true
          },
          "asOfUtc": {
            "type": "string",
            "format": "date-time"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentEvent"
            }
          }
        }
      },
      "Guidance": {
        "type": "object",
        "properties": {
          "found": {
            "type": "boolean"
          },
          "paymentId": {
            "type": "string"
          },
          "policyFound": {
            "type": "boolean"
          },
          "recommendation": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "nullable": true,
            "properties": {
              "policyId": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "sectionId": {
                "type": "string"
              },
              "uri": {
                "type": "string",
                "format": "uri"
              },
              "excerpt": {
                "type": "string",
                "description": "Exact text of the cited policy section."
              }
            }
          }
        }
      },
      "PaymentNotFound": {
        "type": "object",
        "properties": {
          "found": {
            "type": "boolean"
          },
          "paymentId": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
